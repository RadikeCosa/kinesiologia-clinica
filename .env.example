# Server-side only. Disposable local HAPI used for development and tests.
# The local-real endpoint is http://localhost:8080/fhir and must be selected explicitly.
# Never expose either value through NEXT_PUBLIC_*.
FHIR_BASE_URL=http://localhost:8081/fhir

# Local passkey access. Replace the bootstrap value with a random secret of 32+ characters.
# Keep the actual value only in .env.local; never commit it.
AUTH_ORIGIN=http://localhost:3000
AUTH_DB_PATH=.local/auth.sqlite
AUTH_BOOTSTRAP_TOKEN=
