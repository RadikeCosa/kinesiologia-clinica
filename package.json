{
  "name": "kinesiologia-clinica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "FHIR_BASE_URL=http://localhost:8081/fhir next dev --webpack",
    "dev:fhir-dev": "FHIR_BASE_URL=http://localhost:8081/fhir next dev --webpack",
    "dev:lan": "FHIR_BASE_URL=http://localhost:8081/fhir AUTH_ORIGIN=https://dev-pc.local:3000 AUTH_DB_PATH=.local/auth-lan.sqlite next dev --webpack --hostname 0.0.0.0 --experimental-https --experimental-https-key .local/dev-pc.local-key.pem --experimental-https-cert .local/dev-pc.local.pem",
    "dev:fhir-real": "FHIR_BASE_URL=http://localhost:8080/fhir next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration:fhir": "FHIR_INTEGRATION_BASE_URL=http://localhost:8081/fhir vitest run tests/integration",
    "test:e2e": "playwright test",
    "seed:clinical-home": "node scripts/seed-clinical-home.mjs",
    "reset:fhir-dev": "node scripts/reset-fhir-dev.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/helpers": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "better-sqlite3": "^12.10.0",
    "next": "16.3.5",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.14",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
